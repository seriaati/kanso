# kanso configuration: cp .env.example .env. Each setting is explained in docs/SETUP.md, step 6.

KANSO_PORT=8000

# `openssl rand -hex 24`. Set it before the first start.
POSTGRES_PASSWORD=change-me

# Only needed when running the backend outside Docker.
# DATABASE_URL=postgresql+asyncpg://kanso:change-me@localhost:5432/kanso
# REDIS_URL=redis://localhost:6379/0

# The address you open kanso at, without a trailing slash.
PUBLIC_URL=http://localhost:8000

# `openssl rand -hex 32`. Changing it signs you out and means reconnecting every Gmail account.
SECRET_KEY=

# Paste the line printed by: docker compose run --rm --no-deps app python -m kanso.hash_password
PASSWORD_HASH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: instant mail notifications. Without them kanso checks Gmail every 2 minutes.
# GOOGLE_PUBSUB_TOPIC=projects/<project-id>/topics/kanso-gmail
# GOOGLE_PUBSUB_SUBSCRIPTION=projects/<project-id>/subscriptions/kanso-gmail
# The service account key, as printed by `base64 -w0 key.json`.
# GOOGLE_PUBSUB_CREDENTIALS=

# AI API keys (Anthropic, TypeSafe) are not set here: add them in kanso under Settings -> AI keys.

# Only behind a reverse proxy: the proxy addresses whose X-Forwarded-For header is trusted.
# FORWARDED_ALLOW_IPS=*
