# kanso configuration. Copy to .env and edit: cp .env.example .env

# Port kanso is served on, at http://localhost:<port>. Put your own HTTPS reverse proxy in front of
# it to reach it from other devices.
KANSO_PORT=8000

# Password for the bundled Postgres database. Pick any long random string, e.g. `openssl rand -hex 24`.
# Set it before the first start: Postgres stores it when it creates its data volume.
POSTGRES_PASSWORD=change-me

# Connection URLs. docker compose sets both to the bundled services, so you only need these when
# running the backend outside Docker (`uv run uvicorn kanso.main:app` in backend/).
# DATABASE_URL=postgresql+asyncpg://kanso:change-me@localhost:5432/kanso
# REDIS_URL=redis://localhost:6379/0

# The address you open kanso at, as typed in the browser, without a trailing slash. kanso builds
# the Google redirect URI from it (<PUBLIC_URL>/api/accounts/callback), and an https:// address
# marks the login cookie Secure. If you change KANSO_PORT, change the port here too.
PUBLIC_URL=http://localhost:8000

# Signs your login session and encrypts the Gmail tokens kanso stores. Generate it with
# `openssl rand -hex 32`. Changing it signs you out and means reconnecting every Gmail account.
SECRET_KEY=

# argon2 hash of your login password. Generate it with
#   docker compose run --rm --no-deps app python -m kanso.hash_password
# and paste the line it prints here, single quotes included.
PASSWORD_HASH=

# Your Google Cloud OAuth client (docs/SETUP.md, steps 1-4).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail push notifications through Google Cloud Pub/Sub (docs/SETUP.md, step 5). Optional:
# without them kanso checks Gmail for changes every 2 minutes instead of within seconds.
# GOOGLE_PUBSUB_TOPIC=projects/<project-id>/topics/kanso-gmail
# GOOGLE_PUBSUB_SUBSCRIPTION=projects/<project-id>/subscriptions/kanso-gmail
# The service account's JSON key, base64-encoded on one line: `base64 -w0 key.json`
# GOOGLE_PUBSUB_CREDENTIALS=

# Claude (Anthropic API). Optional: with a key, kanso sorts new inbox mail into the labels you
# mark "AI-managed", groups the inbox by label, summarizes long threads and adds the assistant.
# Without one, every AI feature is hidden. For each new inbox message, its sender, subject and a
# trimmed body (no quoted replies, signature or attachments) are sent to Claude; for a summary,
# the thread's subject and each message's sender, date and trimmed body (never recipients or
# attachments). The assistant sends your questions, the date and the open thread's subject, and
# what it looks up: search results (subject, sender names, date, labels, a short snippet) and
# the threads it reads (sender, date, trimmed body). It changes mail only after you confirm,
# unless you turn that off in Settings. It never sends or deletes mail.
# ANTHROPIC_API_KEY=
# The models, if you want others: a small, fast one for labeling and a stronger one for thread
# summaries and the assistant. AI_SUMMARY_MODEL overrides AI_MODEL for summaries only, e.g.
# claude-haiku-5-5 if they arrive too slowly.
# AI_LABEL_MODEL=claude-haiku-5-5
# AI_MODEL=claude-sonnet-5-5
# AI_SUMMARY_MODEL=

# Only behind a reverse proxy (docs/SETUP.md, step 8): the proxy addresses whose X-Forwarded-For
# header kanso trusts, so login rate limiting sees real client addresses.
# FORWARDED_ALLOW_IPS=*
